# Cloudflare Pages 응답 헤더 설정
# 형식: 경로 한 줄 → 그 아래 헤더들을 2칸 들여쓰기
# 문서: https://developers.cloudflare.com/pages/configuration/headers/

/*
  # MIME 타입 추측 금지 (스크립트로 오인해 실행되는 것 방지)
  X-Content-Type-Options: nosniff

  # 다른 사이트가 iframe으로 우리 페이지를 감싸는 것 차단 (클릭재킹 방지)
  X-Frame-Options: DENY

  # 외부 사이트로 이동할 때 전체 경로 대신 도메인만 전달
  Referrer-Policy: strict-origin-when-cross-origin

  # 쓰지 않는 브라우저 기능 차단
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()

  # HTTPS 강제 (1년). 서브도메인은 포함하지 않음 — 나중에 추가할 서브도메인이
  # HTTPS가 아닐 경우 접속이 막히는 것을 피하기 위함.
  Strict-Transport-Security: max-age=31536000

  # 콘텐츠 보안 정책
  #  - 기본은 자기 자신만 허용
  #  - style/font: Google Fonts 허용
  #  - 'unsafe-inline': 이 사이트는 CSS와 JS를 HTML 안에 직접 넣는 구조라 필요.
  #    (해시 방식으로 바꾸면 HTML을 수정할 때마다 해시를 다시 계산해야 해서
  #     손으로 편집하는 이 저장소에는 맞지 않음)
  #  - img: data: 는 배경 그레인 SVG용
  #  - script-src/connect-src에 cloudflareinsights: Cloudflare Web Analytics를
  #    대시보드에서 켜면 beacon.min.js가 자동 주입된다. 이 두 항목이 없으면
  #    CSP가 beacon을 차단해 수집이 0건이 된다 (2026-08-11 실측으로 확인)
  #  - frame-src: 곡 미리듣기 임베드 (SoundCloud / YouTube)
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; frame-src https://w.soundcloud.com https://open.spotify.com https://www.youtube-nocookie.com https://www.youtube.com; upgrade-insecure-requests

# ── 캐시 정책 ─────────────────────────────────────────────
# HTML: 배포 즉시 반영이 최우선이므로 짧게 둡니다.
#   Cloudflare Pages 기본값도 max-age=0, must-revalidate 이므로 사실상 기본과 같습니다.
#   엣지 캐싱(CDN-Cache-Control / s-maxage)을 켜면 배포 후에도 옛 페이지가 남을 수 있고,
#   Cloudflare 문서도 커스텀 도메인에서의 커스텀 캐싱을 권장하지 않습니다.
#   → cf-cache-status가 DYNAMIC으로 나오는 것은 의도된 결과입니다.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# 내용이 거의 바뀌지 않는 자산: 30일.
#   immutable은 붙이지 않습니다 — 붙이면 max-age 동안 재검증 자체를 건너뛰어
#   교체했을 때 되돌릴 방법이 purge밖에 없어집니다.
#   og.png / favicon.svg를 교체하면 Cloudflare 대시보드에서 purge 하거나
#   파일명을 바꿔야 합니다.
/og.png
  Cache-Control: public, max-age=2592000

/favicon.svg
  Cache-Control: public, max-age=2592000

# 크롤러가 읽는 파일: 하루.
#   sitemap은 lastmod가 바뀌면 빨리 반영되는 편이 나아 길게 잡지 않습니다.
/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400
